<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">
    <!-- use camera is a must -->
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.CAMERA" />
    <uses-feature android:name="android.hardware.camera" android:required="true"/>

    <!--
         Required for MonitoringService (Phase F): running the camera +
         web server as a foreground service so monitoring survives the
         screen turning off / the Activity going to the background.

         FOREGROUND_SERVICE_CAMERA is the API 34+ specific-use permission
         required in addition to the general FOREGROUND_SERVICE permission
         whenever a foreground service's type includes "camera".

         POST_NOTIFICATIONS is required at runtime on API 33+ to show the
         persistent foreground-service notification; must be requested from
         MainActivity before starting the service.

         WAKE_LOCK will back a PARTIAL_WAKE_LOCK held by the service so the
         CPU doesn't sleep under Doze while the screen is off.
    -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_CAMERA" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.WAKE_LOCK" />

    <application
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.VenusFlytrapMonitor">
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:screenOrientation="landscape"
            android:theme="@style/Theme.VenusFlytrapMonitor" >
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!--
             Phase F, step 2: bare-bones foreground service, proving the
             notification/permission mechanics before any camera code
             moves here (step 3). foregroundServiceType "camera" must
             match the FOREGROUND_SERVICE_TYPE_CAMERA value passed to
             startForeground() in MonitoringService.
        -->
        <service
            android:name=".MonitoringService"
            android:exported="false"
            android:foregroundServiceType="camera" />
    </application>

</manifest>